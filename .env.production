# Production build settings, committed on purpose: everything here is public
# and ends up in the shipped JavaScript. Vite reads this file for every
# production build, which covers both hosts (GitHub Pages via deploy.yml and
# the Cloudflare copy via Workers Builds) with no per-host configuration.
#
# Visitor beacons (beacon-api/). Empty the value to switch the feature off on
# both hosts: no buoys, no button, no B key, no requests.
VITE_BEACON_API=https://fitz-beacons.fitzgeralmedia.workers.dev

# Live sky (beacon-api/ Sky room): other pilots flying now, as ghost ships.
# Empty the value to switch it off on both hosts: no ghosts, no switch, no socket.
VITE_LIVE_SKY=wss://fitz-beacons.fitzgeralmedia.workers.dev/live
