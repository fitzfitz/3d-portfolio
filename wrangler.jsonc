// Production: an assets-only Worker serving the Vite build at
// porto.fitzgeral.my.id (a Custom Domain on this Worker) and
// 3d-portfolio.fitzgeralmedia.workers.dev. Only a version tag deploys it, via
// .github/workflows/release.yml; Workers Builds is disconnected so merges to
// main stop at staging (GitHub Pages). beacon-api/ has its own config and is
// always run with --config.
{
  "name": "3d-portfolio",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
